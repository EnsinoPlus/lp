# --- Easypanel (Dockerfile deste repo) ---
# 1) Variáveis VITE_* de build (ex.: VITE_GTM_ID, VITE_CHECKOUT_URL do e-book) precisam
#    existir no momento do `npm run build` — use Build Arguments no Easypanel.
# 2) VITE_SUITEPLUS_CREDITS_CHECKOUT_URL é lida em RUNTIME (env do serviço + restart).
# 3) Porta: a imagem expõe 8787 por padrão; alinhe a porta do serviço Easypanel ou defina PORT.
# 4) Comando local após build: `npm start` (Wrangler servindo dist/server).

# Checkout real fica na Hotmart — use este link nos botões "comprar" da LP do e-book
VITE_CHECKOUT_URL=https://pay.hotmart.com/R105606128X
# SuitePlus — cadastro único (créditos de boas-vindas)
VITE_SUITEPLUS_SIGNUP_URL=https://suiteplus.ensinoplus.com.br/register
# SuitePlus — home e recarga (LP e-book via créditos)
VITE_SUITEPLUS_HOME_URL=https://suiteplus.ensinoplus.com.br/
VITE_SUITEPLUS_RECHARGE_URL=https://suiteplus.ensinoplus.com.br/recarregar
VITE_SUITEPLUS_PROFILE_URL=https://suiteplus.ensinoplus.com.br/perfil
# Ponto Mágico (SuitePlus) — cadastro e app
VITE_PONTO_MAGICO_SIGNUP_URL=https://suiteplus.ensinoplus.com.br/
VITE_PONTO_MAGICO_APP_URL=https://pontomagico.ensinoplus.com.br/
# Apps das demais ferramentas SuitePlus
VITE_CALC_MACHINE_APP_URL=https://calcmachine.ensinoplus.com.br/home
VITE_CHAT_CCT_APP_URL=https://chat.ensinoplus.com.br/
VITE_CONTRACHEQUE_APP_URL=https://contrachequetransparente.ensinoplus.com.br/
VITE_EXTRATOR_AUSENCIAS_APP_URL=https://ausencias.ensinoplus.com.br/
VITE_FGTS_FACIL_APP_URL=https://fgtsfacil.ensinoplus.com.br/
VITE_IMPUGNADOR_APP_URL=https://impugnador.ensinoplus.com.br/
# Promo SuitePlus — checkout de créditos (RUNTIME no Easypanel; restart basta, sem rebuild)
# Aceita também o alias sem prefixo: SUITEPLUS_CREDITS_CHECKOUT_URL
VITE_SUITEPLUS_CREDITS_CHECKOUT_URL=https://suiteplus.ensinoplus.com.br/promo99
# Livro físico PJe-Calc — checkout (RUNTIME; default: /livro)
VITE_SUITEPLUS_BOOK_CHECKOUT_URL=https://suiteplus.ensinoplus.com.br/livro
# Container do Google Tag Manager (GTM)
VITE_GTM_ID=GTM-XXXXXXXX
# Meta Pixel: ID público no build; token CAPI é segredo de runtime e não recebe prefixo VITE_.
VITE_META_PIXEL_ID=984600751325289
META_PIXEL_ID=984600751325289
META_CONVERSIONS_API_TOKEN=cole-o-token-da-conversions-api-aqui
# CCT 2026 — LP de cadastro (conversão público frio)
# IMPORTANTE: VITE_SUPABASE_* precisam existir no BUILD (Build Args no Easypanel).
# Mesmas credenciais anon do projeto login (SuitePlus Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Opcionais — defaults apontam para suiteplus.ensinoplus.com.br
VITE_SUITEPLUS_CREATE_USER_URL=https://suiteplus.ensinoplus.com.br/api/credits/create-user
VITE_SUITEPLUS_CONFIRM_EMAIL_URL=https://suiteplus.ensinoplus.com.br/confirm-email
VITE_CCT_SIGNUP_URL=https://suiteplus.ensinoplus.com.br/register?origem=cct
VITE_CCT_WHATSAPP_URL=https://wa.me/5584920002384
# Brevo — funil CCT (RUNTIME no Easypanel; NÃO use prefixo VITE_ — a key fica só no servidor)
BREVO_API_KEY=your-brevo-api-key
BREVO_CCT_FUNNEL_LIST_ID=46
# Conversão de compra oficial: Hotmart (evitar disparo duplicado no front)
